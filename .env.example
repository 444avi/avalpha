# avalpha secrets. Copy to .env (same directory as config.toml) and fill in.
# .env is gitignored and auto-loaded by load_config on this machine.
# In production these instead live in /etc/avalpha/env (systemd EnvironmentFile).
# Real environment variables always override this file.

# SEC EDGAR requires a real contact email in the User-Agent, or requests are
# blocked outright. Required for every collector run.
AVALPHA_CONTACT_EMAIL=you@example.com

# Anthropic — matcher confirm pass, scorer, enrichment, digest narratives.
ANTHROPIC_API_KEY=

# Gmail app password — sending the morning digest via Gmail SMTP. Needs 2FA on
# the account, then generate at https://myaccount.google.com/apppasswords.
# The Gmail address is config.toml [email] sender. test-digest works without it.
GMAIL_APP_PASSWORD=

# Reddit "script" app (https://www.reddit.com/prefs/apps) — reddit collector.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Finnhub — price data (prices collector, free-tier /quote endpoint).
FINNHUB_API_KEY=

# FRED (St. Louis Fed) — macro release dates for the calendar (CPI, PPI, jobs,
# GDP, PCE, retail, jobless claims), and the released actuals for the digest's
# post-event "What happened" block. Free, instant: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# FMP (Financial Modeling Prep) — OPTIONAL. Enables macro beat/miss vs consensus
# in the digest (calendar_outcomes.macro_consensus). Leave blank: there is no
# free macro-consensus source today (Finnhub /calendar/economic is 403 on the
# free tier, TE guest is discontinued), so the seam stays inert unless you have a
# paid FMP plan whose economic-calendar endpoint returns estimates.
FMP_API_KEY=
