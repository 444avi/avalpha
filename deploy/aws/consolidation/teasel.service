[Unit]
Description=Teasel Flask app (gunicorn)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=teasel
Group=teasel
WorkingDirectory=/opt/teasel
ExecStart=/opt/teasel/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5050 app:app
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
