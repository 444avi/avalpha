[Unit]
Description=Sundew notification settings UI
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data/sundew

[Service]
Type=simple
User=sundew
Group=sundew
WorkingDirectory=/opt/sundew
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sundew/.venv/bin/python /opt/sundew/settings_server.py --host 127.0.0.1 --port 8787 --app-db /data/sundew/app.db --env /etc/sundew/env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
