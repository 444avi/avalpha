# avalpha configuration. Copy to config.toml (next to this file) or set
# AVALPHA_CONFIG to its path. Secrets live in the environment, not here —
# see the [env] comment block at the bottom.

[storage]
# Use durable disk on the cloud host (e.g. an attached volume), not ephemeral
# instance storage — the DB is the archive and must survive restarts.
db_path = "/opt/avalpha/data/avalpha.db"
digest_dir = "/opt/avalpha/data/digests"

[email]
recipient = "you@example.com"
# Sent via Amazon SES, authenticated by the EC2 instance role (no password).
# The address here is the From header and must be on a verified SES identity —
# the arboretuminvestments.net domain (a display name is fine). Region comes
# from AWS_REGION and defaults to us-west-1.
sender = "avalpha <alerts@arboretuminvestments.net>"

[reddit]
subreddits = ["stocks", "investing", "wallstreetbets", "StockMarket", "options"]

[models]
# confirm: high-volume matcher yes/no. scorer: per-item materiality verdicts
# (also high-volume). narrative: the few daily "what mattered" digest summaries
# — kept on a stronger model since it's cheap at that volume and quality-critical.
confirm = "claude-haiku-4-5"
scorer = "claude-haiku-4-5"
narrative = "claude-sonnet-4-6"

# --- Environment variables (systemd EnvironmentFile=/etc/avalpha/env, or a
#     local .env next to this file for development) ---
# ANTHROPIC_API_KEY      required
# FINNHUB_API_KEY        required for the prices collector
# AWS_REGION             optional — Amazon SES region for sending (default us-west-1);
#                        auth is the EC2 instance role, so no mail password is needed
# SES_CONFIGURATION_SET  optional — SES config set for bounce/complaint tracking
#                        via SNS (default arboretum-notifications; empty disables)
# REDDIT_CLIENT_ID       required for the reddit collector
# REDDIT_CLIENT_SECRET   required for the reddit collector
# AVALPHA_CONTACT_EMAIL  required — goes in the SEC EDGAR User-Agent header
